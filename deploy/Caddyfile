{$CADDY_SITE_ADDRESS} {
    encode gzip

    handle /healthz {
        respond "ok" 200
    }

    @api {
        path /ingest/matchzy*
        path /ingest/demo*
        path /api/*
    }
    handle @api {
        reverse_proxy {$API_UPSTREAM}
    }

    handle {
        reverse_proxy {$FRONTEND_UPSTREAM}
    }
}
