# Authentication token expected from MatchZy ingest requests
SERVER_TOKEN=change-me

# Demo storage path (absolute or relative)
DEMO_STORAGE_PATH=./storage/demos

# PostgreSQL connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=matchzy
POSTGRES_PASSWORD=matchzy
POSTGRES_DB=matchzy

# NATS JetStream
NATS_URL=nats://nats:4222
NATS_SUBJECT_MATCHZY_EVENTS=matchzy.events.raw
# JetStream monitoring endpoint proxied by Caddy (/jsz)
JSZ_MONITOR_URL=http://caddy/jsz?state=summary

# API configuration
PORT=3000

# Destructive operations require explicit opt-in
ALLOW_DB_DROP=false

# Demo reupload agent
DEMO_REUPLOAD_INGEST_URL=http://api:3000/ingest/demo
DEMO_REUPLOAD_AGENT_PATH=/agent/reupload
DEMO_REUPLOAD_API_KEY=

# Emergency demo GC defaults
EMERGENCY_GC_POLL_INTERVAL_MS=60000
EMERGENCY_GC_DEFAULT_GRACE_MINUTES=30
EMERGENCY_GC_DEFAULT_ENABLED=false
EMERGENCY_GC_DISABLE_AUTORUN=false

# PostgreSQL backup binaries
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
