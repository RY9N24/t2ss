# Authentication token expected from MatchZy ingest requests
SERVER_TOKEN=change-me

# Demo storage path (absolute or relative)
DEMO_STORAGE_PATH=./storage/demos

# PostgreSQL connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=matchzy
POSTGRES_PASSWORD=matchzy
POSTGRES_DB=matchzy

# NATS JetStream
NATS_URL=nats://nats:4222
NATS_SUBJECT_MATCHZY_EVENTS=matchzy.events.raw

# API configuration
PORT=3000
